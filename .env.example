# DeepSeek must only be read from server-side code. Never prefix this key with NEXT_PUBLIC_.
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Optional: protects /ai-status and /api/ai/status in production. The page
# never reveals the full API key; it only shows masked configuration status.
AI_DIAGNOSTICS_TOKEN=choose-a-private-diagnostics-token

# Optional: public site origin used for metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Optional: only needed for real likes and the seven-day ranking.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Production content gate. Set true to keep draft recipes out of public pages,
# APIs, AI and blindbox results until they have a real cooking review. Set
# false only when you intentionally publish drafts with their review labels.
KEEP_DRAFT_RECIPES_PRIVATE=false
