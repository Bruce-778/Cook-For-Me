{
  "name": "cook-for-me",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "validate:content": "tsx scripts/validate-recipes.ts && tsx scripts/validate-dietary.ts",
    "validate:ai": "tsx scripts/validate-ai-safety.ts",
    "validate:supabase": "tsx scripts/validate-supabase-schema.ts",
    "validate:videos": "tsx scripts/check-bilibili-links.ts",
    "test:local": "tsx scripts/smoke-local.ts",
    "seed:supabase": "tsx scripts/sync-recipes-to-supabase.ts",
    "validate:production": "tsx scripts/validate-production-config.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.24.0",
    "next": "16.3.6",
    "radix-ui": "^1.6.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "postcss": "8.5.28",
    "shadcn": "^4.13.0",
    "sharp": "0.35.4",
    "tailwindcss": "^4",
    "tsx": "4.23.1",
    "typescript": "^5"
  }
}
